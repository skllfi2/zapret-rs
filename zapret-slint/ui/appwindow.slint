import { ScrollView } from "std-widgets.slint";

// ============================================================================
// WINDOWS 11 FLUENT DARK TOKENS (Calm, Professional Slate/Zinc Palette)
// ============================================================================
// Canvas (Mica/Acrylic): #202020
// Sidebar: #1c1c1c (border #2c2c2c)
// Card Background: #2b2b2b (border #333333, hover border #444444)
// Inner Card / Icon Container: #333333
// Primary Accent: #0078d4 (muted, professional Windows blue)
// Text Colors:
//   Primary:   #ffffff (high contrast, crisp)
//   Secondary: #cccccc (clean readable gray)
//   Muted:     #888888 (subtle guidance text)
// Status Colors (Subtle, not oversaturated):
//   Green: #107c41 (or #22c55e muted)
//   Amber: #d97706
//   Red:   #dc2626

// ============================================================================
// 1. WINUI 3 BUTTON
// ============================================================================
component WinButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <length> min_w: 80px;
    callback clicked();

    min-width: root.min_w;
    height: 32px;
    border-radius: 5px;
    border-width: 1px;

    background: !root.enabled ? #2a2a2a :
                root.danger ? (touch.pressed ? #991b1b : (touch.has-hover ? #b91c1c : #2f2525)) :
                root.primary ? (touch.pressed ? #005a9e : (touch.has-hover ? #106ebe : #0078d4)) :
                (touch.pressed ? #323232 : (touch.has-hover ? #3a3a3a : #2e2e2e));

    border-color: !root.enabled ? #333333 :
                  root.danger ? (touch.has-hover ? #ef4444 : #5c2828) :
                  root.primary ? (touch.has-hover ? #60cdff : #0078d4) :
                  (touch.has-hover ? #505050 : #3c3c3c);

    animate background, border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;

        Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.primary ? 600 : 400;
            color: !root.enabled ? #666666 :
                   root.danger ? (touch.has-hover ? #ffffff : #f87171) :
                   root.primary ? #ffffff :
                   (touch.has-hover ? #ffffff : #e0e0e0);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// 2. WINUI 3 TOGGLE SWITCH
// ============================================================================
component WinToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> on_label: "Вкл";
    in property <string> off_label: "Выкл";
    callback toggled(bool);

    width: 84px;
    height: 30px;
    background: transparent;

    HorizontalLayout {
        spacing: 8px;
        alignment: end;

        Text {
            text: root.checked ? root.on_label : root.off_label;
            font-size: 11px;
            font-weight: 500;
            color: root.checked ? #e0e0e0 : #888888;
            vertical-alignment: center;
        }

        // Switch pill
        Rectangle {
            width: 40px;
            height: 20px;
            border-radius: 10px;
            background: root.checked ? (touch.has-hover ? #106ebe : #0078d4) : (touch.has-hover ? #383838 : #2e2e2e);
            border-width: 1px;
            border-color: root.checked ? #60cdff : #4a4a4a;
            animate background, border-color { duration: 120ms; }

            // Thumb
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: #ffffff;
                x: root.checked ? parent.width - self.width - 3px : 4px;
                y: (parent.height - self.height) / 2;
                animate x { duration: 120ms; easing: ease-out; }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// ============================================================================
// 3. STATUS BADGE
// ============================================================================
component StatusBadge inherits Rectangle {
    in property <string> text: "";
    in property <color> badge_color: #0078d4;

    background: badge_color.transparentize(0.85);
    border-radius: 4px;
    border-width: 1px;
    border-color: badge_color.transparentize(0.5);
    height: 22px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 600;
            color: root.badge_color;
            vertical-alignment: center;
        }
    }
}

// ============================================================================
// 4. SIDEBAR NAVIGATION ITEM
// ============================================================================
component NavItem inherits Rectangle {
    in property <string> icon: "";
    in property <string> text: "";
    in property <bool> active: false;
    callback clicked();

    height: 36px;
    border-radius: 5px;
    background: root.active ? #2e2e2e : (touch.has-hover ? #252525 : transparent);
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        alignment: start;

        // Accent indicator bar on left
        Rectangle {
            width: 3px;
            height: 16px;
            border-radius: 1.5px;
            background: root.active ? #60cdff : transparent;
            y: (parent.height - self.height) / 2;
            animate background { duration: 120ms; }
        }

        Text {
            text: root.icon;
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? #ffffff : (touch.has-hover ? #f0f0f0 : #a0a0a0);
            vertical-alignment: center;
            animate color { duration: 100ms; }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// 5. WINUI 3 SETTINGS CARD
// ============================================================================
component SettingsCard inherits Rectangle {
    in property <string> icon: "⚙️";
    in property <string> title: "";
    in property <string> description: "";

    background: #2b2b2b;
    border-radius: 6px;
    border-width: 1px;
    border-color: #383838;
    min-height: 56px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 14px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            horizontal-stretch: 1;

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 6px;
                background: #333333;
                border-width: 1px;
                border-color: #3f3f3f;
                y: (parent.height - self.height) / 2;

                Text {
                    text: root.icon;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 2px;
                alignment: center;

                Text {
                    text: root.title;
                    font-size: 13px;
                    font-weight: 600;
                    color: #ffffff;
                }
                Text {
                    text: root.description;
                    font-size: 11px;
                    color: #aaaaaa;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            @children
        }
    }
}

// ============================================================================
// MAIN WINDOW
// ============================================================================
export component MainWindow inherits Window {
    title: "ZAPRET SIMPLE";
    icon: @image-url("../assets/app.png");
    min-width: 980px;
    min-height: 640px;
    preferred-width: 1040px;
    preferred-height: 700px;
    background: #202020;
    default-font-family: "Segoe UI Variable, Segoe UI";

    in property <string> zapret_version: "v1.10.4";
    in property <string> service_status: "Остановлена";
    in property <color> status_color: #f59e0b;
    in property <string> admin_status: "Администратор";
    in property <color> admin_color: #22c55e;
    in property <[string]> strategies: [];
    in-out property <int> selected_strategy_index: 0;

    in property <string> game_filter_text: "Отключен";
    in property <string> ipset_text: "Загружен";
    in property <bool> ipset_active: true;
    in property <string> check_updates_text: "Включена";

    in property <string> doh_provider_text: "Отключен (DHCP)";
    in property <bool> doh_active: false;
    in property <bool> sound_enabled: true;
    in property <string> autostart_text: "Отключена";
    in property <bool> autostart_active: false;

    in property <string> log_output: "";
    in property <bool> is_running: false;

    in-out property <int> active_tab: 0;
    // Скрываемый нижний терминал вывода
    in-out property <bool> console_open: false;

    callback toggle_service();
    callback remove_service();
    callback service_status_details();
    callback apply_strategy();

    callback toggle_game_filter();
    callback toggle_ipset();
    callback toggle_check_updates();
    callback inspect_fakes();
    callback toggle_doh();
    callback toggle_sound();
    callback toggle_autostart();
    callback select_zapret_folder();
    callback unpack_zapret_zip();

    callback update_ipset();
    callback check_hosts();
    callback check_updates();

    callback run_diagnostics();
    callback run_tests();
    callback clear_discord();
    callback remove_conflicts();
    callback open_original_service();
    callback clear_log();

    HorizontalLayout {
        // ====================================================================
        // ЛЕВЫЙ САЙДБАР (SIDEBAR)
        // ====================================================================
        Rectangle {
            width: 220px;
            background: #1c1c1c;
            border-width: 1px;
            border-color: #2c2c2c;

            VerticalLayout {
                padding-top: 14px;
                padding-bottom: 14px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;

                // Заголовок бренда
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 6px;
                        background: #0078d4;
                        Text {
                            text: "⚡";
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "ZAPRET SIMPLE";
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                            letter-spacing: 0.3px;
                        }
                        Text {
                            text: "WINDOWS DPI BYPASS";
                            font-size: 9px;
                            color: #888888;
                        }
                    }
                }

                // Индикаторы версии и прав
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    StatusBadge {
                        text: root.zapret_version;
                        badge_color: #60cdff;
                    }
                    StatusBadge {
                        text: root.admin_status;
                        badge_color: root.admin_color;
                    }
                }

                // Карточка статуса сервиса
                Rectangle {
                    background: #252525;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #333333;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.status_color;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: root.service_status;
                                font-size: 12px;
                                font-weight: 600;
                                color: root.status_color;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            WinButton {
                                text: root.is_running ? "⏹ Стоп" : "▶ Пуск";
                                primary: !root.is_running;
                                danger: root.is_running;
                                min_w: 90px;
                                clicked => { root.toggle_service(); }
                            }
                            WinButton {
                                text: "Инфо";
                                min_w: 60px;
                                clicked => { root.service_status_details(); }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: #2c2c2c; }

                Text {
                    text: "МЕНЮ";
                    font-size: 10px;
                    font-weight: 700;
                    color: #777777;
                    letter-spacing: 0.5px;
                }

                // Вкладки
                VerticalLayout {
                    spacing: 2px;
                    NavItem {
                        icon: "🛡️";
                        text: "Служба";
                        active: root.active_tab == 0;
                        clicked => { root.active_tab = 0; }
                    }
                    NavItem {
                        icon: "⚙️";
                        text: "Параметры";
                        active: root.active_tab == 1;
                        clicked => { root.active_tab = 1; }
                    }
                    NavItem {
                        icon: "🔄";
                        text: "Обновления";
                        active: root.active_tab == 2;
                        clicked => { root.active_tab = 2; }
                    }
                    NavItem {
                        icon: "🛠️";
                        text: "Инструменты";
                        active: root.active_tab == 3;
                        clicked => { root.active_tab = 3; }
                    }
                    NavItem {
                        icon: "📋";
                        text: "Журнал логов";
                        active: root.active_tab == 4;
                        clicked => { root.active_tab = 4; }
                    }
                }

                Rectangle { vertical-stretch: 1; }
                Rectangle { height: 1px; background: #2c2c2c; }

                // Футер
                WinButton {
                    text: root.sound_enabled ? "🔊 Звуки: Вкл" : "🔇 Звуки: Выкл";
                    clicked => { root.toggle_sound(); }
                }
            }
        }

        // ====================================================================
        // ОСНОВНАЯ ОБЛАСТЬ (CONTENT AREA)
        // ====================================================================
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            horizontal-stretch: 1;

            // Верхняя полоса страницы
            Rectangle {
                height: 44px;
                background: #252525;
                border-radius: 6px;
                border-width: 1px;
                border-color: #333333;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    Text {
                        text: root.active_tab == 0 ? "Управление службой и стратегиями" :
                              root.active_tab == 1 ? "Параметры и фильтрация трафика" :
                              root.active_tab == 2 ? "Обновление списков и компонентов" :
                              root.active_tab == 3 ? "Системная диагностика и инструменты" :
                                                     "Журнал событий";
                        font-size: 13px;
                        font-weight: 600;
                        color: #ffffff;
                        vertical-alignment: center;
                    }

                    if root.active_tab != 4: HorizontalLayout {
                        alignment: end;
                        spacing: 8px;

                        WinButton {
                            text: root.console_open ? "▼ Скрыть лог" : "▲ Показать лог";
                            min_w: 110px;
                            clicked => { root.console_open = !root.console_open; }
                        }
                    }
                }
            }

            // ================================================================
            // ВКЛАДКА 0: СЛУЖБА
            // ================================================================
            if root.active_tab == 0: ScrollView {
                VerticalLayout {
                    spacing: 8px;
                    padding-right: 4px;

                    SettingsCard {
                        icon: "🎯";
                        title: "Активная стратегия обхода DPI";
                        description: "Пресет параметров winws для обхода замедлений YouTube и Discord";

                        StatusBadge {
                            text: root.strategies.length > 0 ? root.strategies[root.selected_strategy_index] : "general";
                            badge_color: #60cdff;
                            y: (parent.height - self.height) / 2;
                        }
                        WinButton {
                            text: "Сменить";
                            min_w: 75px;
                            clicked => {
                                if (root.strategies.length > 0) {
                                    root.selected_strategy_index = (root.selected_strategy_index + 1) >= root.strategies.length ? 0 : root.selected_strategy_index + 1;
                                }
                            }
                            y: (parent.height - self.height) / 2;
                        }
                        WinButton {
                            text: "Применить";
                            primary: true;
                            min_w: 85px;
                            clicked => { root.apply_strategy(); }
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    SettingsCard {
                        icon: "🛡️";
                        title: "Служба Windows (zapret)";
                        description: "Управление фоновым сервисом WinWS в диспетчере служб Windows";

                        WinButton {
                            text: root.is_running ? "⏹ Остановить" : "▶ Запустить";
                            primary: !root.is_running;
                            danger: root.is_running;
                            min_w: 105px;
                            clicked => { root.toggle_service(); }
                            y: (parent.height - self.height) / 2;
                        }
                        WinButton {
                            text: "Статус службы";
                            min_w: 100px;
                            clicked => {
                                root.console_open = true;
                                root.service_status_details();
                            }
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    SettingsCard {
                        icon: "⚙️";
                        title: "Системные действия";
                        description: "Запуск оригинального bat-скрипта или удаление службы из системы";

                        WinButton {
                            text: "Оригинальный service.bat";
                            min_w: 160px;
                            clicked => { root.open_original_service(); }
                            y: (parent.height - self.height) / 2;
                        }
                        WinButton {
                            text: "Удалить службу";
                            danger: true;
                            min_w: 115px;
                            clicked => { root.remove_service(); }
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            // ================================================================
            // ВКЛАДКА 1: ПАРАМЕТРЫ
            // ================================================================
            if root.active_tab == 1: ScrollView {
                VerticalLayout {
                    spacing: 8px;
                    padding-right: 4px;

                    SettingsCard {
                        icon: "🎮";
                        title: "Игровой фильтр (GameFilter)";
                        description: "Исключение игровых UDP/P2P портов для защиты от задержек";

                        StatusBadge {
                            text: root.game_filter_text;
                            badge_color: root.game_filter_text == "Отключен" ? #888888 : #22c55e;
                            y: (parent.height - self.height) / 2;
                        }
                        WinButton {
                            text: "Сменить";
                            min_w: 80px;
                            clicked => { root.toggle_game_filter(); }
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    SettingsCard {
                        icon: "🌐";
                        title: "Фильтр IPSet (ipset-all.txt)";
                        description: "Фильтровать трафик только к заблокированным ресурсам из базы";

                        WinToggle {
                            checked: root.ipset_active;
                            on_label: "Загружен";
                            off_label: "Отключен";
                            toggled => { root.toggle_ipset(); }
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    SettingsCard {
                        icon: "🔒";
                        title: "DNS over HTTPS (DoH)";
                        description: "Шифрование DNS-запросов (Cloudflare, Google, AdGuard) без утечек через IPv6";

                        StatusBadge {
                            text: root.doh_provider_text;
                            badge_color: root.doh_active ? #22c55e : #888888;
                            y: (parent.height - self.height) / 2;
                        }
                        WinButton {
                            text: "Сменить";
                            min_w: 80px;
                            clicked => { root.toggle_doh(); }
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    SettingsCard {
                        icon: "🚀";
                        title: "Автозагрузка с Windows";
                        description: "Автоматический старт zapret-simple в системный трей при входе в Windows";

                        WinToggle {
                            checked: root.autostart_active;
                            on_label: "Включена";
                            off_label: "Отключена";
                            toggled => { root.toggle_autostart(); }
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    SettingsCard {
                        icon: "🔄";
                        title: "Автопроверка обновлений";
                        description: "Проверять наличие свежих версий zapret на GitHub при запуске программы";

                        WinToggle {
                            checked: root.check_updates_text == "Включена";
                            on_label: "Включена";
                            off_label: "Отключена";
                            toggled => { root.toggle_check_updates(); }
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    SettingsCard {
                        icon: "📦";
                        title: "Fake Payloads (*.bin)";
                        description: "Инспекция установленных бинарных фейк-пакетов в папке bin/";

                        WinButton {
                            text: "Список фейков";
                            min_w: 110px;
                            clicked => {
                                root.console_open = true;
                                root.inspect_fakes();
                            }
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            // ================================================================
            // ВКЛАДКА 2: ОБНОВЛЕНИЯ
            // ================================================================
            if root.active_tab == 2: ScrollView {
                VerticalLayout {
                    spacing: 8px;
                    padding-right: 4px;

                    SettingsCard {
                        icon: "🌐";
                        title: "Обновление базы IPSet";
                        description: "Загрузить актуальный список ipset-service.txt из репозитория Flowseal";

                        WinButton {
                            text: "Обновить IPSet";
                            primary: true;
                            min_w: 120px;
                            clicked => {
                                root.console_open = true;
                                root.update_ipset();
                            }
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    SettingsCard {
                        icon: "📄";
                        title: "Проверка файла Hosts";
                        description: "Поиск записей в hosts, нарушающих работу сервисов YouTube и Discord";

                        WinButton {
                            text: "Проверить Hosts";
                            min_w: 120px;
                            clicked => {
                                root.console_open = true;
                                root.check_hosts();
                            }
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    SettingsCard {
                        icon: "🚀";
                        title: "Проверка релизов zapret";
                        description: "Сравнение текущей локальной версии с последней на GitHub";

                        WinButton {
                            text: "Проверить релизы";
                            min_w: 120px;
                            clicked => {
                                root.console_open = true;
                                root.check_updates();
                            }
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            // ================================================================
            // ВКЛАДКА 3: ИНСТРУМЕНТЫ
            // ================================================================
            if root.active_tab == 3: ScrollView {
                VerticalLayout {
                    spacing: 8px;
                    padding-right: 4px;

                    SettingsCard {
                        icon: "🔍";
                        title: "Комплексная диагностика (18 проверок)";
                        description: "Глубокая проверка WinDivert, сетевых адаптеров, DNS, портов и фильтров";

                        WinButton {
                            text: "Запустить диагностику";
                            primary: true;
                            min_w: 155px;
                            clicked => {
                                root.console_open = true;
                                root.run_diagnostics();
                            }
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    SettingsCard {
                        icon: "⚡";
                        title: "Тестирование и конфликты";
                        description: "Запуск теста zapret.ps1 и нейтрализация конфликтующих служб";

                        WinButton {
                            text: "Тест zapret.ps1";
                            min_w: 115px;
                            clicked => { root.run_tests(); }
                            y: (parent.height - self.height) / 2;
                        }
                        WinButton {
                            text: "Устранить конфликты";
                            min_w: 140px;
                            clicked => {
                                root.console_open = true;
                                root.remove_conflicts();
                            }
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    SettingsCard {
                        icon: "🧹";
                        title: "Очистка кэша Discord";
                        description: "Завершение процессов Discord и очистка временных файлов кэша";

                        WinButton {
                            text: "Очистить кэш";
                            min_w: 110px;
                            clicked => {
                                root.console_open = true;
                                root.clear_discord();
                            }
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    SettingsCard {
                        icon: "📁";
                        title: "Управление файлами zapret";
                        description: "Ручной выбор рабочей папки или распаковка дистрибутива из ZIP архива";

                        WinButton {
                            text: "Выбрать папку";
                            min_w: 110px;
                            clicked => {
                                root.console_open = true;
                                root.select_zapret_folder();
                            }
                            y: (parent.height - self.height) / 2;
                        }
                        WinButton {
                            text: "Распаковать ZIP";
                            min_w: 120px;
                            clicked => {
                                root.console_open = true;
                                root.unpack_zapret_zip();
                            }
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            // ================================================================
            // ВКЛАДКА 4: ПОЛНОРАЗМЕРНЫЙ ЖУРНАЛ ЛОГОВ
            // ================================================================
            if root.active_tab == 4: Rectangle {
                vertical-stretch: 1;
                background: #1b1b1b;
                border-radius: 6px;
                border-width: 1px;
                border-color: #2f2f2f;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "ЖУРНАЛ ВЫВОДА ДИАГНОСТИКИ И СЛУЖБЫ";
                            font-size: 11px;
                            font-weight: 700;
                            color: #888888;
                            vertical-alignment: center;
                        }
                        WinButton {
                            text: "Очистить журнал";
                            min_w: 110px;
                            clicked => { root.clear_log(); }
                        }
                    }

                    ScrollView {
                        Text {
                            text: root.log_output;
                            font-family: "Cascadia Mono, Consolas";
                            font-size: 12px;
                            color: #d4d4d4;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // ================================================================
            // СКРЫВАЕМЫЙ ВЫДВИЖНОЙ ДРАВЕР КОНСОЛИ (ДЛЯ ВКЛАДОК 0-3)
            // ================================================================
            if root.active_tab != 4: Rectangle {
                height: root.console_open ? 160px : 30px;
                background: #1c1c1c;
                border-radius: 6px;
                border-width: 1px;
                border-color: #2f2f2f;
                animate height { duration: 160ms; easing: ease-out; }

                VerticalLayout {
                    padding-top: 4px;
                    padding-bottom: 4px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;

                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text {
                                text: "Терминал вывода";
                                font-size: 11px;
                                font-weight: 600;
                                color: #888888;
                                vertical-alignment: center;
                            }
                            if !root.console_open: Text {
                                text: "· Нажмите «Показать лог» при необходимости";
                                font-size: 11px;
                                color: #555555;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;

                            WinButton {
                                text: root.console_open ? "▼ Скрыть" : "▲ Развернуть";
                                min_w: 80px;
                                clicked => { root.console_open = !root.console_open; }
                            }
                            if root.console_open: WinButton {
                                text: "Полный экран";
                                min_w: 95px;
                                clicked => { root.active_tab = 4; }
                            }
                            if root.console_open: WinButton {
                                text: "Очистить";
                                min_w: 70px;
                                clicked => { root.clear_log(); }
                            }
                        }
                    }

                    if root.console_open: ScrollView {
                        Text {
                            text: root.log_output;
                            font-family: "Cascadia Mono, Consolas";
                            font-size: 11px;
                            color: #cccccc;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
