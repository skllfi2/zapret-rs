import { Button, ComboBox, ScrollView } from "std-widgets.slint";

component Card inherits Rectangle {
    background: #161b26;
    border-radius: 8px;
    border-width: 1px;
    border-color: #242c3d;
}

component StatusBadge inherits Rectangle {
    in property <string> text: "";
    in property <color> badge_color: #3b82f6;

    background: badge_color.transparentize(0.85);
    border-radius: 5px;
    border-width: 1px;
    border-color: badge_color.transparentize(0.5);
    height: 22px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 700;
            color: root.badge_color;
            vertical-alignment: center;
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon: "";
    in property <string> text: "";
    in property <bool> active: false;
    callback clicked();

    height: 38px;
    border-radius: 6px;
    background: root.active ? #1e293b : (touch.has-hover ? #172033 : transparent);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        alignment: start;

        // Active indicator bar
        Rectangle {
            width: 3px;
            height: 18px;
            border-radius: 2px;
            background: root.active ? #38bdf8 : transparent;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.icon;
            font-size: 14px;
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            font-size: 13px;
            font-weight: root.active ? 700 : 500;
            color: root.active ? #ffffff : (touch.has-hover ? #f1f5f9 : #94a3b8);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SettingsCard inherits Rectangle {
    in property <string> icon: "⚙️";
    in property <string> title: "";
    in property <string> description: "";

    background: #161b26;
    border-radius: 8px;
    border-width: 1px;
    border-color: #242c3d;
    min-height: 58px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            horizontal-stretch: 1;

            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 7px;
                background: #1e2638;
                border-width: 1px;
                border-color: #2e3a52;
                y: (parent.height - self.height) / 2;

                Text {
                    text: root.icon;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                spacing: 2px;
                alignment: center;

                Text {
                    text: root.title;
                    font-size: 13px;
                    font-weight: 700;
                    color: #ffffff;
                }
                Text {
                    text: root.description;
                    font-size: 11px;
                    color: #8b9bb4;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            @children
        }
    }
}

export component MainWindow inherits Window {
    title: "ZAPRET SIMPLE (Native Slint)";
    icon: @image-url("../assets/app.png");
    min-width: 1000px;
    min-height: 700px;
    preferred-width: 1060px;
    preferred-height: 740px;
    background: #0f1219;
    default-font-family: "Segoe UI";

    in property <string> zapret_version: "v1.10.4";
    in property <string> service_status: "Остановлена";
    in property <color> status_color: #f59e0b;
    in property <string> admin_status: "Администратор";
    in property <color> admin_color: #22c55e;
    in property <[string]> strategies: [];
    in-out property <int> selected_strategy_index: 0;

    in property <string> game_filter_text: "Отключен";
    in property <string> ipset_text: "Загружен";
    in property <bool> ipset_active: true;
    in property <string> check_updates_text: "Включена";

    in property <string> doh_provider_text: "Отключен (DHCP)";
    in property <bool> doh_active: false;
    in property <bool> sound_enabled: true;
    in property <string> autostart_text: "Отключена";
    in property <bool> autostart_active: false;

    in property <string> log_output: "";
    in property <bool> is_running: false;

    in-out property <int> active_tab: 0;

    callback toggle_service();
    callback remove_service();
    callback service_status_details();
    callback apply_strategy();

    callback toggle_game_filter();
    callback toggle_ipset();
    callback toggle_check_updates();
    callback inspect_fakes();
    callback toggle_doh();
    callback toggle_sound();
    callback toggle_autostart();
    callback select_zapret_folder();
    callback unpack_zapret_zip();

    callback update_ipset();
    callback check_hosts();
    callback check_updates();

    callback run_diagnostics();
    callback run_tests();
    callback clear_discord();
    callback remove_conflicts();
    callback open_original_service();
    callback clear_log();

    HorizontalLayout {
        // ==========================================
        // 1. ЛЕВЫЙ САЙДБАР (SIDEBAR)
        // ==========================================
        Rectangle {
            width: 230px;
            background: #131620;
            border-width: 1px;
            border-color: #1e2433;

            VerticalLayout {
                padding: 12px;
                spacing: 12px;

                // Бренд и логотип
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 8px;
                        background: #2563eb;
                        Text {
                            text: "⚡";
                            font-size: 18px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "ZAPRET SIMPLE";
                            font-size: 14px;
                            font-weight: 800;
                            color: #ffffff;
                            letter-spacing: 0.5px;
                        }
                        Text {
                            text: "WINDOWS DPI BYPASS";
                            font-size: 9px;
                            font-weight: 700;
                            color: #60a5fa;
                            letter-spacing: 0.5px;
                        }
                    }
                }

                // Бейджи версии и прав
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    StatusBadge {
                        text: root.zapret_version;
                        badge_color: #60a5fa;
                    }
                    StatusBadge {
                        text: root.admin_status;
                        badge_color: root.admin_color;
                    }
                }

                // Карточка статуса службы
                Rectangle {
                    background: #181d2a;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #262f44;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Rectangle {
                                width: 9px;
                                height: 9px;
                                border-radius: 4px;
                                background: root.status_color;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: root.service_status;
                                font-size: 12px;
                                font-weight: 700;
                                color: root.status_color;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            Button {
                                text: root.is_running ? "⏹ Стоп" : "▶ Пуск";
                                primary: !root.is_running;
                                clicked => { root.toggle_service(); }
                            }
                            Button {
                                text: "Инфо";
                                clicked => { root.service_status_details(); }
                            }
                        }
                    }
                }

                // Разделитель
                Rectangle {
                    height: 1px;
                    background: #1e2433;
                }

                // Заголовок навигации
                Text {
                    text: "НАВИГАЦИЯ";
                    font-size: 10px;
                    font-weight: 800;
                    color: #64748b;
                    letter-spacing: 0.8px;
                }

                // Список вкладок (Navigation items)
                VerticalLayout {
                    spacing: 4px;
                    NavItem {
                        icon: "🛡️";
                        text: "Служба";
                        active: root.active_tab == 0;
                        clicked => { root.active_tab = 0; }
                    }
                    NavItem {
                        icon: "⚙️";
                        text: "Параметры";
                        active: root.active_tab == 1;
                        clicked => { root.active_tab = 1; }
                    }
                    NavItem {
                        icon: "🔄";
                        text: "Обновления";
                        active: root.active_tab == 2;
                        clicked => { root.active_tab = 2; }
                    }
                    NavItem {
                        icon: "🛠️";
                        text: "Инструменты";
                        active: root.active_tab == 3;
                        clicked => { root.active_tab = 3; }
                    }
                    NavItem {
                        icon: "📋";
                        text: "Журнал логов";
                        active: root.active_tab == 4;
                        clicked => { root.active_tab = 4; }
                    }
                }

                // Пружина
                Rectangle {
                    vertical-stretch: 1;
                }

                // Разделитель футера
                Rectangle {
                    height: 1px;
                    background: #1e2433;
                }

                // Футер сайдбара
                Button {
                    text: root.sound_enabled ? "🔊 Звуки: Вкл" : "🔇 Звуки: Выкл";
                    clicked => { root.toggle_sound(); }
                }
            }
        }

        // ==========================================
        // 2. ОСНОВНОЙ КОНТЕНТ (MAIN CONTENT AREA)
        // ==========================================
        VerticalLayout {
            padding: 14px;
            spacing: 12px;
            horizontal-stretch: 1;

            // Верхняя плашка текущего раздела
            Rectangle {
                height: 48px;
                background: #161b26;
                border-radius: 8px;
                border-width: 1px;
                border-color: #242c3d;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    Text {
                        text: root.active_tab == 0 ? "🛡️ Управление службой и стратегиями" :
                              root.active_tab == 1 ? "⚙️ Параметры и фильтрация трафика" :
                              root.active_tab == 2 ? "🔄 Обновление списков и компонентов" :
                              root.active_tab == 3 ? "🛠️ Системная диагностика и инструменты" :
                                                     "📋 Журнал событий и консоль вывода";
                        font-size: 15px;
                        font-weight: 700;
                        color: #ffffff;
                        vertical-alignment: center;
                    }

                    // Быстрый выбор стратегии прямо в шапке для вкладки 0
                    if root.active_tab == 0: HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Text {
                            text: "Стратегия:";
                            font-size: 12px;
                            font-weight: 600;
                            color: #94a3b8;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            model: root.strategies;
                            current-index <=> root.selected_strategy_index;
                            width: 200px;
                        }
                        Button {
                            text: "Применить";
                            primary: true;
                            clicked => { root.apply_strategy(); }
                        }
                    }
                }
            }

            // ВКЛАДКА 0: СЛУЖБА
            if root.active_tab == 0: VerticalLayout {
                spacing: 10px;

                SettingsCard {
                    icon: "🎯";
                    title: "Выбор активной стратегии DPI";
                    description: "Пресеты параметров winws для обхода замедлений YouTube, Discord и веб-сайтов";

                    ComboBox {
                        model: root.strategies;
                        current-index <=> root.selected_strategy_index;
                        width: 200px;
                        y: (parent.height - self.height) / 2;
                    }
                    Button {
                        text: "Применить";
                        primary: true;
                        clicked => { root.apply_strategy(); }
                        y: (parent.height - self.height) / 2;
                    }
                }

                SettingsCard {
                    icon: "🛡️";
                    title: "Управление службой Windows";
                    description: "Запуск, остановка и проверка состояния системного сервиса zapret";

                    Button {
                        text: root.is_running ? "⏹ Остановить службу" : "▶ Запустить службу";
                        primary: !root.is_running;
                        clicked => { root.toggle_service(); }
                        y: (parent.height - self.height) / 2;
                    }
                    Button {
                        text: "Подробный статус";
                        clicked => { root.service_status_details(); }
                        y: (parent.height - self.height) / 2;
                    }
                }

                SettingsCard {
                    icon: "⚙️";
                    title: "Системные действия службы";
                    description: "Удаление службы из реестра SCM или запуск оригинального скрипта";

                    Button {
                        text: "Оригинальный service.bat";
                        clicked => { root.open_original_service(); }
                        y: (parent.height - self.height) / 2;
                    }
                    Button {
                        text: "Удалить службу";
                        clicked => { root.remove_service(); }
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // ВКЛАДКА 1: ПАРАМЕТРЫ
            if root.active_tab == 1: VerticalLayout {
                spacing: 8px;

                SettingsCard {
                    icon: "🎮";
                    title: "Игровой фильтр (GameFilter)";
                    description: "Исключение игровых UDP портов и P2P трафика для предотвращения задержек";

                    StatusBadge {
                        text: root.game_filter_text;
                        badge_color: root.game_filter_text == "Отключен" ? #94a3b8 : #22c55e;
                        y: (parent.height - self.height) / 2;
                    }
                    Button {
                        text: "Сменить";
                        clicked => { root.toggle_game_filter(); }
                        y: (parent.height - self.height) / 2;
                    }
                }

                SettingsCard {
                    icon: "🌐";
                    title: "Фильтр IPSet (ipset-all.txt)";
                    description: "Фильтрация DPI только для известных заблокированных IP адресов";

                    StatusBadge {
                        text: root.ipset_text;
                        badge_color: root.ipset_active ? #22c55e : #ef4444;
                        y: (parent.height - self.height) / 2;
                    }
                    Button {
                        text: "Вкл / Выкл";
                        clicked => { root.toggle_ipset(); }
                        y: (parent.height - self.height) / 2;
                    }
                }

                SettingsCard {
                    icon: "🔒";
                    title: "DNS over HTTPS (DoH)";
                    description: "Шифрование DNS-запросов (Cloudflare, Google, AdGuard) для обхода перехвата";

                    StatusBadge {
                        text: root.doh_provider_text;
                        badge_color: root.doh_active ? #22c55e : #94a3b8;
                        y: (parent.height - self.height) / 2;
                    }
                    Button {
                        text: "Сменить DoH";
                        clicked => { root.toggle_doh(); }
                        y: (parent.height - self.height) / 2;
                    }
                }

                SettingsCard {
                    icon: "🚀";
                    title: "Автозагрузка с Windows";
                    description: "Автоматический запуск zapret-simple при старте операционной системы";

                    StatusBadge {
                        text: root.autostart_text;
                        badge_color: root.autostart_active ? #22c55e : #94a3b8;
                        y: (parent.height - self.height) / 2;
                    }
                    Button {
                        text: "Переключить";
                        clicked => { root.toggle_autostart(); }
                        y: (parent.height - self.height) / 2;
                    }
                }

                SettingsCard {
                    icon: "🔄";
                    title: "Автопроверка обновлений";
                    description: "Автоматический запрос новых версий zapret на GitHub при запуске программы";

                    StatusBadge {
                        text: root.check_updates_text;
                        badge_color: root.check_updates_text == "Включена" ? #22c55e : #94a3b8;
                        y: (parent.height - self.height) / 2;
                    }
                    Button {
                        text: "Переключить";
                        clicked => { root.toggle_check_updates(); }
                        y: (parent.height - self.height) / 2;
                    }
                }

                SettingsCard {
                    icon: "📦";
                    title: "Fake Payloads (*.bin)";
                    description: "Просмотр установленных бинарных фейковых пакетов в папке zapret/bin/";

                    Button {
                        text: "Список фейков в bin/";
                        clicked => { root.inspect_fakes(); }
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // ВКЛАДКА 2: ОБНОВЛЕНИЯ
            if root.active_tab == 2: VerticalLayout {
                spacing: 10px;

                SettingsCard {
                    icon: "🌐";
                    title: "Обновление базы IPSet";
                    description: "Загрузить свежий список ipset-service.txt из репозитория Flowseal";

                    Button {
                        text: "Обновить IPSet";
                        primary: true;
                        clicked => { root.update_ipset(); }
                        y: (parent.height - self.height) / 2;
                    }
                }

                SettingsCard {
                    icon: "📄";
                    title: "Проверка системного файла Hosts";
                    description: "Анализ файла hosts на наличие записей, блокирующих сервисы";

                    Button {
                        text: "Проверить Hosts";
                        clicked => { root.check_hosts(); }
                        y: (parent.height - self.height) / 2;
                    }
                }

                SettingsCard {
                    icon: "🚀";
                    title: "Проверка обновлений zapret";
                    description: "Сравнение текущей локальной версии с последним релизом на GitHub";

                    Button {
                        text: "Проверить обновления";
                        clicked => { root.check_updates(); }
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // ВКЛАДКА 3: ИНСТРУМЕНТЫ
            if root.active_tab == 3: VerticalLayout {
                spacing: 8px;

                SettingsCard {
                    icon: "🔍";
                    title: "Комплексная диагностика (18 проверок)";
                    description: "Глубокая проверка WinDivert, сетевых адаптеров, DNS, портов и фильтров";

                    Button {
                        text: "Запустить диагностику";
                        primary: true;
                        clicked => { root.run_diagnostics(); }
                        y: (parent.height - self.height) / 2;
                    }
                }

                SettingsCard {
                    icon: "⚡";
                    title: "Тестирование и конфликты";
                    description: "Запуск тестового скрипта zapret.ps1 и нейтрализация конфликтующих служб";

                    Button {
                        text: "Тесты zapret.ps1";
                        clicked => { root.run_tests(); }
                        y: (parent.height - self.height) / 2;
                    }
                    Button {
                        text: "Устранить конфликты";
                        clicked => { root.remove_conflicts(); }
                        y: (parent.height - self.height) / 2;
                    }
                }

                SettingsCard {
                    icon: "🧹";
                    title: "Очистка кэша Discord";
                    description: "Завершение зависших процессов Discord и удаление временных файлов кэша";

                    Button {
                        text: "Очистить кэш Discord";
                        clicked => { root.clear_discord(); }
                        y: (parent.height - self.height) / 2;
                    }
                }

                SettingsCard {
                    icon: "📁";
                    title: "Управление файлами zapret";
                    description: "Ручной выбор рабочей папки или распаковка дистрибутива из ZIP архива";

                    Button {
                        text: "Выбрать папку zapret";
                        clicked => { root.select_zapret_folder(); }
                        y: (parent.height - self.height) / 2;
                    }
                    Button {
                        text: "Распаковать zapret.zip";
                        clicked => { root.unpack_zapret_zip(); }
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // ВКЛАДКА 4: ПОЛНОРАЗМЕРНЫЙ ЖУРНАЛ ЛОГОВ
            if root.active_tab == 4: Card {
                vertical-stretch: 1;
                background: #0d1017;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "ЖУРНАЛ СООБЩЕНИЙ И ВЫВОД ДИАГНОСТИКИ";
                            font-size: 11px;
                            font-weight: 800;
                            color: #64748b;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "Очистить журнал";
                            clicked => { root.clear_log(); }
                        }
                    }

                    ScrollView {
                        Text {
                            text: root.log_output;
                            font-family: "Consolas";
                            font-size: 12px;
                            color: #e2e8f0;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // ДЛЯ ВКЛАДОК 0-3: КОМПАКТНЫЙ ВЫДВИЖНОЙ ДРАВЕР ЛОГОВ ВНИЗУ
            if root.active_tab != 4: Card {
                height: 150px;
                background: #0d1017;

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "КОНСОЛЬ ВЫВОДА";
                            font-size: 10px;
                            font-weight: 800;
                            color: #64748b;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button {
                                text: "На весь экран";
                                clicked => { root.active_tab = 4; }
                            }
                            Button {
                                text: "Очистить";
                                clicked => { root.clear_log(); }
                            }
                        }
                    }

                    ScrollView {
                        Text {
                            text: root.log_output;
                            font-family: "Consolas";
                            font-size: 11px;
                            color: #cbd5e1;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
