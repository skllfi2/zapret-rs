#!/bin/sh
# pre-commit hook zapret-simple: ruff + юнит-тесты перед каждым коммитом.
# Подключается через: git config core.hooksPath hooks
# C1: PY переопределяется снаружи (PY=/path/python git commit ...), иначе —
# захардкоженный -> py -3.15 -> python. $PY без кавычек намеренно:
# значение "py -3.15" — это две команды.
if [ -z "$PY" ]; then
  if [ -f "C:/Users/dexox/AppData/Local/Python/pythoncore-3.15-64/python.exe" ]; then
    PY="C:/Users/dexox/AppData/Local/Python/pythoncore-3.15-64/python.exe"
  elif command -v py >/dev/null 2>&1; then
    PY="py -3.15"
  else
    PY="python"
  fi
fi

echo "[pre-commit] ruff check ..."
$PY -m ruff check . || exit 1

echo "[pre-commit] unittest discover -s tests ..."
PYTHONUTF8=1 $PY -X utf8 -m unittest discover -s tests -q || exit 1

echo "[pre-commit] OK"
