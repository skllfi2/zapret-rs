# .coveragerc — отчёт покрытия zapret-simple
#   coverage run -m unittest discover -s tests && coverage report
# shiboken/PySide6 при импорте регистрирует модули с относительными путями
# (shibokensupport/*, pyscript, signature_bootstrap.py) — таких файлов в проекте нет,
# и без omit отчёт падал с "No source for code" (couldnt-parse).
[run]
omit =
    shibokensupport/*
    signature_bootstrap.py
    pyscript

[report]
omit =
    shibokensupport/*
    signature_bootstrap.py
    pyscript
fail_under = 90
show_missing = true
